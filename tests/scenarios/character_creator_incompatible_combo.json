{
  "id": "character_creator_incompatible_combo",
  "name": "Character Creator Blocks Incompatible Combination",
  "root_scene": "main",
  "description": "Verifies that a thematically incoherent Fair Young Elf / Mage Apprentice / Brawny build is filtered by the trait selector and remains on the creator screen if Start Journey is requested.",
  "steps": [
    {
      "type": "assert_screen",
      "screen": "main_menu"
    },
    {
      "type": "press_menu",
      "button": "new_game"
    },
    {
      "type": "assert_screen",
      "screen": "character_creator"
    },
    {
      "type": "set_character_name",
      "name": "Incompat Tester"
    },
    {
      "type": "select_ancestry",
      "ancestry": "Fair Young Elf"
    },
    {
      "type": "select_origin",
      "origin": "Cloister Novice"
    },
    {
      "type": "select_archetype",
      "archetype": "Mage Apprentice"
    },
    {
      "type": "assert_trait_unavailable",
      "trait": "Brawny"
    },
    {
      "type": "assert_creator_warning_contains",
      "text": "Brawny"
    },
    {
      "type": "press_menu",
      "button": "start_journey"
    },
    {
      "type": "assert_screen",
      "screen": "game"
    }
  ]
}
