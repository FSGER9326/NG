{
  "id": "main_menu_new_game",
  "name": "Main Menu New Game Flow",
  "root_scene": "main",
  "description": "Verifies that the game boots to the main menu, opens the data-driven character creator, stores a profile with ancestry/background/class/trait tags, and starts the Wolfpine Road prototype.",
  "steps": [
    {
      "type": "assert_screen",
      "screen": "main_menu"
    },
    {
      "type": "press_menu",
      "button": "new_game"
    },
    {
      "type": "assert_screen",
      "screen": "character_creator"
    },
    {
      "type": "set_character_name",
      "name": "Test Wanderer"
    },
    {
      "type": "select_ancestry",
      "ancestry": "Border Human"
    },
    {
      "type": "select_origin",
      "origin": "Caravan Guard"
    },
    {
      "type": "select_archetype",
      "archetype": "Scout"
    },
    {
      "type": "select_trait",
      "trait": "Quick-Eyed"
    },
    {
      "type": "press_menu",
      "button": "start_journey"
    },
    {
      "type": "assert_screen",
      "screen": "game"
    },
    {
      "type": "assert_player_profile",
      "name": "Test Wanderer",
      "ancestry": "Border Human",
      "origin": "Caravan Guard",
      "background": "Caravan Guard",
      "archetype": "Scout",
      "class": "Scout",
      "trait": "Quick-Eyed"
    },
    {
      "type": "assert_player_profile",
      "tag": "labor.guard"
    },
    {
      "type": "assert_player_profile",
      "tag": "trait.quick_eyed"
    },
    {
      "type": "assert_area",
      "area_id": "wolfpine_road"
    }
  ]
}
